# ─────────────────────────────────────────────────────────────
# SIMU · CDMX — variables de entorno
# Copia este archivo a .env antes de `docker compose up`.
# Los valores son SOLO para desarrollo local. Cámbialos en cualquier
# entorno compartido. Usa contraseñas sin caracteres especiales de URL
# (@ : / ? #) porque se interpolan en DATABASE_URL.
# ─────────────────────────────────────────────────────────────

# PostgreSQL + PostGIS
POSTGRES_USER=simu
POSTGRES_PASSWORD=simu_dev_password
POSTGRES_DB=simu
POSTGRES_PORT=5432

# Solo para correr la API/seed fuera de Docker (npm run dev:api).
# Dentro de Docker, compose construye su propia URL hacia el host "postgres".
DATABASE_URL=postgresql://simu:simu_dev_password@localhost:5432/simu?schema=public

# API
API_PORT=3000
LOG_LEVEL=info
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# true solo si la web se sirve por HTTPS
COOKIE_SECURE=false
# Intentos de login por minuto por IP
LOGIN_RATE_LIMIT_MAX=10

# Motor de reglas y dispositivos (opcionales; estos son los valores por defecto)
# HEARTBEAT_TIMEOUT_S=90
# HEARTBEAT_CHECK_INTERVAL_S=10
# CAMERA_MIN_CONFIDENCE=0.6
# CAMERA_DEDUP_MINUTES=15
# CAMERA_EVENT_MAX_AGE_MIN=30
# WEATHER_MAX_AGE_MIN=180
# SYNC_LATE_THRESHOLD_S=60

# Clave compartida que envían gateway y simulador en el header x-device-key
DEVICE_INGEST_KEY=dev-only-device-key-change-me

# Base de datos para pruebas de integración (npm test). Debe existir y tener PostGIS.
# Se trunca y re-siembra en cada corrida: NUNCA apuntes a la base de desarrollo.
TEST_DATABASE_URL=postgresql://simu:simu_dev_password@localhost:5432/simu_test?schema=public

# Contraseña de los 4 usuarios demo creados por el seed
SEED_DEMO_PASSWORD=simu2026

# Web (puerto publicado en el host)
WEB_PORT=5173

# Simulador (fuera de Docker apunta a la API local)
SIMULATOR_PORT=4000
SIMULATOR_API_URL=http://localhost:3000

# Servicio de IA opcional (docker compose --profile ai up).
# Vacío = la API usa su mock interno.
AI_SERVICE_URL=
