{
  "name": "@simu/simulator",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@simu/shared-types": "*",
    "@simu/shared-utils": "*",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.10",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.2.7"
  }
}
